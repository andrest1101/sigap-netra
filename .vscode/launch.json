{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Windows (debug)",
      "request": "launch",
      "type": "dart",
      "program": "lib/main.dart",
      "deviceId": "windows",
      "flutterMode": "debug",
      "cwd": "${workspaceFolder}"
    },
    {
      "name": "Windows (run without debugging)",
      "request": "launch",
      "type": "dart",
      "noDebug": true,
      "program": "lib/main.dart",
      "deviceId": "windows",
      "flutterMode": "debug",
      "cwd": "${workspaceFolder}"
    }
  ]
}
